BYBIT_API_KEY=
BYBIT_SECRET=
TESTNET=true

SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT,XRP/USDT:USDT,DOGE/USDT:USDT,SUI/USDT:USDT,AVAX/USDT:USDT,LINK/USDT:USDT,ADA/USDT:USDT,BNB/USDT:USDT,NEAR/USDT:USDT,APT/USDT:USDT,ARB/USDT:USDT,OP/USDT:USDT,SEI/USDT:USDT

ATR_MIN_PCT=0.12
VOL_MULT=1.8
OB_IMB=1.2

RISK_PER_TRADE_PCT=1.0
LEVERAGE=10
MAX_POSITIONS=4
DAY_LOSS_PCT=4.0

ENTRY_TIMEOUT_S=8
BE_TRIGGER=1.2
BE_OFFSET_PCT=0.0006
TIME_STOP_MIN=20
POLL_SEC=2

# paper-режим (python paper.py) — ключи не нужны: реальные данные Bybit, симуляция сделок
PAPER_START_EQUITY=1000
PAPER_POLL_SEC=5

TG_TOKEN=
TG_CHAT_ID=

# веб-панель (run_bot.sh / DASH_PORT=8080 python paper.py): DASH_HOST=0.0.0.0 для VPS
DASH_HOST=127.0.0.1
DASH_PORT=8080

STATE_FILE=state.json
LOG_FILE=bot.log
LOG_LEVEL=INFO

# резервные домены Bybit через запятую (при 403/гео-блоке автоматически перебираются)
# BYBIT_HOSTS=bybit.com,bytick.com,bybit.nl
